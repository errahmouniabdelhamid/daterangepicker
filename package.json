{
  "name": "daterangepicker",
  "version": "4.0.0",
  "description": "Date range picker component - TypeScript with Tailwind CSS and Vite",
  "type": "module",
  "main": "./dist/daterangepicker.umd.js",
  "module": "./dist/daterangepicker.es.js",
  "types": "./dist/daterangepicker.d.ts",
  "exports": {
    ".": {
      "import": "./dist/daterangepicker.es.js",
      "require": "./dist/daterangepicker.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dangrossman/daterangepicker.git"
  },
  "author": {
    "name": "Dan Grossman",
    "email": "dan@dangrossman.info",
    "url": "http://www.dangrossman.info"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dangrossman/daterangepicker/issues"
  },
  "homepage": "https://github.com/dangrossman/daterangepicker",
  "dependencies": {
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/moment": "^2.11.29",
    "@types/node": "^24.10.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
